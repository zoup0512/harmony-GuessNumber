# HarmonyOS .gitignore
.idea/
.ohos/
.hvigor/
*.iml
*.iws
*.ipr
modules.xml
compiler.xml
navigation.xml
build/
out/
cache/
generated/
hvigor-build/
oh-build/
entry/build/
feature/build/
*/build/
*/oh-build/
oh_modules/
node_modules/
local.properties
signing.properties
*.p12
*.jks
*.keystore
secret.key
*.log
*.tmp
*.dump
lint-report*
build-log*
package-lock.json
yarn.lock
.DS_Store
Thumbs.db
*.swp
*.swo

# Debug signing material is versioned so every development machine signs identically.
# The material/ directory holds the DevEco secret-store keys that decrypt the
# passwords in build-profile.json5; without it signing fails elsewhere.
/keystore/*
!/keystore/debug/
!/keystore/debug/**
